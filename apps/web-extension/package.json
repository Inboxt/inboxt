{
	"name": "inboxt",
	"description": "Save articles and newsletters to your Inboxt instance for a clean, focused reading experience.",
	"homepage": "https://inboxt.app",
	"license": "AGPL-3.0-only",
	"version": "1.2.2",
	"type": "module",
	"scripts": {
		"dev": "wxt -b firefox",
		"dev:chrome": "wxt",
		"build": "wxt build -b firefox",
		"build:chrome": "wxt build",
		"zip": "wxt zip -b firefox",
		"zip:chrome": "wxt zip",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@inboxt/common": "1.2.2",
		"@inboxt/ui": "1.2.2",
		"@mantine/core": "9.4.2",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@wxt-dev/module-react": "1.2.2",
		"@wxt-dev/auto-icons": "1.1.1",
		"wxt": "0.20.27"
	}
}
