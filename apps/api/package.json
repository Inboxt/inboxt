	"scripts": {
		"build": "nest build",
		"db:seed": "node dist/seed.js",
		"prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
		"prisma:introspect": "prisma db pull",
		"start": "nest start",
		"start:dev": "npm run prisma:generate && nest start --watch --preserveWatchOutput",
		"migrate:up": "node-pg-migrate up",
		"migrate:down": "node-pg-migrate down",
		"migrate:create": "node-pg-migrate create --templateFileName ../../node_modules/node-pg-migrate/templates/migration-template.ts --tsconfig=tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@apollo/server": "5.5.1",
